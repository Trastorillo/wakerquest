+#if defined(AURORA_GFX_DEKO3D)
+// The deko3d NRO (switch/native/aurora/patches/0016): no compute pass on Dawn's Null device. The
+// encoder (switch/deko/aurora/dk_encode.cpp) takes the pending request when it records the frame's
+// last EFB pass and copies the depth itself; read_latest reads its copies (dk::depth_peek_read).
+// Logical EFB pixel (x, y) is depth image pixel floor(offset + (x + 0.5, y + 0.5) * scale), as the
+// compute shader samples it.
+struct SnapshotMapping {
+  uint32_t logicalWidth = 0;
+  uint32_t logicalHeight = 0;
+  float offsetX = 0.f;
+  float offsetY = 0.f;
+  float scaleX = 1.f;
+  float scaleY = 1.f;
+};
+// render worker: whether GXPeekZ asked for a snapshot (cleared; the 30 Hz limit as for the compute
+// pass), and the mapping for a depth image whose EFB part is sourceWidth x sourceHeight
+bool take_snapshot_request(uint32_t sourceWidth, uint32_t sourceHeight, SnapshotMapping& mapping) noexcept;
+#endif
