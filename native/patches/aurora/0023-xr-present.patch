+#pragma once
+
+/* XR presentation (centollOS patch 0023), Android only.
+ *
+ * While an XR layer of the application has enabled it, Aurora's present pass draws the frame (the
+ * EFB copy and ImGui) into one of three AHardwareBuffers instead of the window surface, which is
+ * then neither acquired nor presented. The XR layer, on its own thread and graphics context, takes
+ * the newest finished frame and shows it in the headset. Everywhere else these do nothing. */
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct AHardwareBuffer AHardwareBuffer;
+
+typedef struct AuroraXrFrame {
+  /* R8G8B8A8_UNORM, GPU_COLOR_OUTPUT | GPU_SAMPLED_IMAGE; row 0 is the top of the picture, which
+   * holds the game's (sRGB-encoded) colours. Aurora keeps its own reference while the buffer is in
+   * its ring: a consumer that keeps the buffer past aurora_xr_present_done acquires its own. */
+  AHardwareBuffer* buffer;
+  /* A sync file that signals when the frame is written, or -1; the caller owns it (closes it). */
+  int syncFd;
+  uint32_t width;
+  uint32_t height;
+  uint32_t serial; /* counts the frames published */
+} AuroraXrFrame;
+
+/* Starts or stops presenting into the buffers (any thread). Takes effect from the next frame. */
+void aurora_xr_present_enable(bool enable);
+/* Whether the device can present into the buffers (known once Aurora has initialized). */
+bool aurora_xr_present_supported(void);
+/* The newest frame finished since the last take, if any. The buffer is marked as being read and is
+ * not written again until aurora_xr_present_done. */
+bool aurora_xr_present_take(AuroraXrFrame* out);
+/* The last taken buffer is no longer read (the reader's GPU work on it has completed). */
+void aurora_xr_present_done(void);
+
+#ifdef __cplusplus
+}
+#endif
