+++ b/lib/webgpu/xr_present.hpp
@@ -0,0 +1,26 @@
+#pragma once
+
+// XR presentation (centollOS patch 0023, include/aurora/xr.h): the present pass's target when an XR
+// layer has enabled it. Android only; elsewhere active() is always false.
+
+#include <webgpu/webgpu_cpp.h>
+
+#include <cstdint>
+
+namespace aurora::webgpu::xr_present {
+
+// Set by gpu.cpp when the device was created with the features the buffers need.
+extern bool g_supported;
+
+// Whether this frame goes to the XR buffers (enabled, supported, and the copy pipeline's format
+// is the buffers' RGBA8Unorm).
+bool active() noexcept;
+// On the render worker: a target of the given size to draw the frame into, or a null view (the
+// frame then goes to the surface as usual). Each begin() is followed by end() after the submit.
+wgpu::TextureView begin(uint32_t width, uint32_t height) noexcept;
+// On the render worker, after the queue submit: publishes the frame to the XR layer.
+void end() noexcept;
+// Drops the buffers (device shutdown).
+void shutdown() noexcept;
+
+} // namespace aurora::webgpu::xr_present
