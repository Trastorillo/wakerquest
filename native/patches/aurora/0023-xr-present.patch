diff --git a/lib/webgpu/xr_present.cpp b/lib/webgpu/xr_present.cpp
new file mode 100644
index 0000000..170b316
--- /dev/null
+++ b/lib/webgpu/xr_present.cpp
@@ -0,0 +1,239 @@
+#include "xr_present.hpp"
+
+#include <aurora/xr.h>
+
+#include "gpu.hpp"
+#include "../internal.hpp"
+
+#include <atomic>
+#include <mutex>
+
+#ifdef __ANDROID__
+#include <android/hardware_buffer.h>
+#include <unistd.h>
+#endif
+
+namespace aurora::webgpu::xr_present {
+bool g_supported = false;
+
+namespace {
+std::atomic_bool g_enabled{false};
+
+#ifdef __ANDROID__
+Module Log("aurora::xr");
+
+constexpr int kSlots = 3;
+
+struct Slot {
+  AHardwareBuffer* buffer = nullptr;
+  wgpu::SharedTextureMemory memory;
+  wgpu::Texture texture;
+  wgpu::TextureView view;
+};
+
+// The ring and its hand-over to the XR layer. The render worker writes a slot that is neither the
+// newest published frame (not yet taken) nor the one the XR layer reads; with three slots one is
+// always free.
+std::mutex g_mutex;
+Slot g_slots[kSlots];
+uint32_t g_width = 0, g_height = 0;
+int g_writing = -1;   // render worker: begun, not yet ended
+int g_latest = -1;    // published, not yet taken
+int g_latestFd = -1;  // its sync file
+int g_reading = -1;   // taken, not yet done
+uint32_t g_serial = 0;
+bool g_failed = false;  // creating the buffers failed: the surface for good
+
+void drop_slots_locked() {
+  for (auto& slot : g_slots) {
+    slot.view = {};
+    slot.texture = {};
+    slot.memory = {};
+    if (slot.buffer != nullptr) {
+      AHardwareBuffer_release(slot.buffer);
+      slot.buffer = nullptr;
+    }
+  }
+  if (g_latestFd >= 0) {
+    close(g_latestFd);
+  }
+  g_latest = g_latestFd = g_reading = g_writing = -1;
+  g_width = g_height = 0;
+}
+
+bool create_slot(Slot& slot, uint32_t width, uint32_t height) {
+  AHardwareBuffer_Desc desc{};
+  desc.width = width;
+  desc.height = height;
+  desc.layers = 1;
+  desc.format = AHARDWAREBUFFER_FORMAT_R8G8B8A8_UNORM;
+  desc.usage = AHARDWAREBUFFER_USAGE_GPU_COLOR_OUTPUT | AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE;
+  if (AHardwareBuffer_allocate(&desc, &slot.buffer) != 0 || slot.buffer == nullptr) {
+    Log.error("AHardwareBuffer_allocate {}x{} failed", width, height);
+    slot.buffer = nullptr;
+    return false;
+  }
+  wgpu::SharedTextureMemoryAHardwareBufferDescriptor ahbDesc;
+  ahbDesc.handle = slot.buffer;
+  wgpu::SharedTextureMemoryDescriptor memoryDesc{.nextInChain = &ahbDesc, .label = "XR target"};
+  slot.memory = g_device.ImportSharedTextureMemory(&memoryDesc);
+  if (!slot.memory) {
+    Log.error("ImportSharedTextureMemory failed");
+    return false;
+  }
+  const wgpu::TextureDescriptor textureDesc{
+      .label = "XR target",
+      .usage = wgpu::TextureUsage::RenderAttachment | wgpu::TextureUsage::TextureBinding,
+      .dimension = wgpu::TextureDimension::e2D,
+      .size = {width, height, 1},
+      .format = wgpu::TextureFormat::RGBA8Unorm,
+      .mipLevelCount = 1,
+      .sampleCount = 1,
+  };
+  slot.texture = slot.memory.CreateTexture(&textureDesc);
+  if (!slot.texture) {
+    Log.error("SharedTextureMemory::CreateTexture failed");
+    return false;
+  }
+  slot.view = slot.texture.CreateView();
+  return true;
+}
+#endif
+} // namespace
+
+bool active() noexcept {
+#ifdef __ANDROID__
+  return g_enabled.load(std::memory_order_relaxed) && g_supported && !g_failed &&
+         g_graphicsConfig.surfaceConfiguration.format == wgpu::TextureFormat::RGBA8Unorm;
+#else
+  return false;
+#endif
+}
+
+wgpu::TextureView begin(uint32_t width, uint32_t height) noexcept {
+#ifdef __ANDROID__
+  if (!active() || width == 0 || height == 0) {
+    return {};
+  }
+  std::lock_guard lock{g_mutex};
+  if (width != g_width || height != g_height) {
+    drop_slots_locked();
+    for (auto& slot : g_slots) {
+      if (!create_slot(slot, width, height)) {
+        drop_slots_locked();
+        g_failed = true;
+        Log.error("XR present unavailable; presenting to the window");
+        return {};
+      }
+    }
+    g_width = width;
+    g_height = height;
+    Log.info("XR present: {} buffers of {}x{}", kSlots, width, height);
+  }
+  int index = 0;
+  while (index == g_latest || index == g_reading) {
+    ++index;
+  }
+  Slot& slot = g_slots[index];
+  // The contents are not kept (the pass clears them) and the XR layer only reads the buffer, so
+  // the image starts in an undefined layout with nothing to wait for.
+  wgpu::SharedTextureMemoryVkImageLayoutBeginState layout;
+  layout.oldLayout = 0; // VK_IMAGE_LAYOUT_UNDEFINED
+  layout.newLayout = 0;
+  wgpu::SharedTextureMemoryBeginAccessDescriptor access{
+      .nextInChain = &layout,
+      .concurrentRead = false,
+      .initialized = false,
+      .fenceCount = 0,
+  };
+  if (!slot.memory.BeginAccess(slot.texture, &access)) {
+    Log.error("SharedTextureMemory::BeginAccess failed");
+    return {};
+  }
+  g_writing = index;
+  return slot.view;
+#else
+  (void)width;
+  (void)height;
+  return {};
+#endif
+}
+
+void end() noexcept {
+#ifdef __ANDROID__
+  std::lock_guard lock{g_mutex};
+  if (g_writing < 0) {
+    return;
+  }
+  Slot& slot = g_slots[g_writing];
+  wgpu::SharedTextureMemoryVkImageLayoutEndState layout;
+  wgpu::SharedTextureMemoryEndAccessState state;
+  state.nextInChain = &layout;
+  int fd = -1;
+  if (slot.memory.EndAccess(slot.texture, &state)) {
+    for (size_t i = 0; i < state.fenceCount && fd < 0; ++i) {
+      wgpu::SharedFenceSyncFDExportInfo syncFd;
+      wgpu::SharedFenceExportInfo info{.nextInChain = &syncFd};
+      state.fences[i].ExportInfo(&info);
+      if (info.type == wgpu::SharedFenceType::SyncFD && syncFd.handle >= 0) {
+        fd = dup(syncFd.handle);
+      }
+    }
+  } else {
+    Log.error("SharedTextureMemory::EndAccess failed");
+  }
+  if (g_latestFd >= 0) {
+    close(g_latestFd);
+  }
+  g_latest = g_writing;
+  g_latestFd = fd;
+  g_writing = -1;
+  ++g_serial;
+#endif
+}
+
+void shutdown() noexcept {
+#ifdef __ANDROID__
+  std::lock_guard lock{g_mutex};
+  drop_slots_locked();
+#endif
+}
+
+} // namespace aurora::webgpu::xr_present
+
+using namespace aurora::webgpu::xr_present;
+
+extern "C" {
+
+void aurora_xr_present_enable(bool enable) { g_enabled.store(enable); }
+
+bool aurora_xr_present_supported(void) { return g_supported; }
+
+bool aurora_xr_present_take(AuroraXrFrame* out) {
+#ifdef __ANDROID__
+  std::lock_guard lock{g_mutex};
+  if (g_latest < 0 || out == nullptr) {
+    return false;
+  }
+  out->buffer = g_slots[g_latest].buffer;
+  out->syncFd = g_latestFd;
+  out->width = g_width;
+  out->height = g_height;
+  out->serial = g_serial;
+  g_reading = g_latest;
+  g_latest = g_latestFd = -1;
+  return true;
+#else
+  (void)out;
+  return false;
+#endif
+}
+
+void aurora_xr_present_done(void) {
+#ifdef __ANDROID__
+  std::lock_guard lock{g_mutex};
+  g_reading = -1;
+#endif
+}
+
+} // extern "C"
