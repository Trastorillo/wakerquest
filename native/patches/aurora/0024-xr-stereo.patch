diff --git a/lib/gfx/stereo.cpp b/lib/gfx/stereo.cpp
new file mode 100644
index 0000000..a61dbfe
--- /dev/null
+++ b/lib/gfx/stereo.cpp
@@ -0,0 +1,100 @@
+#include "stereo.hpp"
+
+#include "frame_packet.hpp"
+#include "recording.hpp"
+#include "../webgpu/gpu.hpp"
+#include "../webgpu/xr_present.hpp"
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+
+namespace aurora::gfx::stereo {
+namespace {
+// Render worker state
+int g_eye = 0;               // 0 mono, -1 left, +1 right
+bool g_frameActive = false;  // this frame's left eye was shifted
+bool g_replaying = false;
+bool g_presented = false;
+float g_strength = 0.f, g_focus = 0.f;  // latched per frame
+bool g_efbPass = false;
+float g_passWidth = 0.f, g_passHeight = 0.f;
+uint32_t g_word = 0;
+webgpu::TextureWithSampler g_left;
+
+std::atomic_bool g_request{false};
+
+int16_t snorm16(float v) { return static_cast<int16_t>(std::lround(std::clamp(v, -1.f, 1.f) * 32767.f)); }
+
+// unpack2x16snorm in the shader: x from the low 16 bits; focus in units of 16384 game units
+uint32_t make_word(int eye) {
+  const float k = static_cast<float>(eye) * g_strength;
+  const uint32_t x = static_cast<uint16_t>(snorm16(k));
+  const uint32_t y = static_cast<uint16_t>(snorm16(g_focus / 16384.f));
+  const uint32_t word = x | (y << 16);
+  return word != 0 ? word : 1u;  // a non-zero word for "shift by nothing"
+}
+} // namespace
+
+void begin_frame() noexcept {
+  g_frameActive = webgpu::xr_present::stereo_wanted();
+  g_strength = webgpu::xr_present::stereo_strength();
+  g_focus = webgpu::xr_present::stereo_focus();
+  g_eye = g_frameActive ? -1 : 0;
+  g_replaying = false;
+}
+
+bool frame_active() noexcept { return g_frameActive; }
+bool replaying() noexcept { return g_replaying; }
+
+void begin_pass(const detail::RenderPass& pass) noexcept {
+  const auto& color = pass.colorAttachments[SceneColorAttachmentIndex];
+  g_efbPass = g_eye != 0 && color.view && color.view.Get() == webgpu::g_frameBuffer.view.Get();
+  // the logical EFB maps to the top-left part of the target under an EFB content scale (patch 0009)
+  const float scale = std::min(1.f, std::max(0.01f, content_scale()));
+  g_passWidth = static_cast<float>(color.size.width) * scale;
+  g_passHeight = static_cast<float>(color.size.height) * scale;
+  g_word = 0;  // every pass sets its viewport first (recording.cpp)
+}
+
+void set_viewport(float width, float height) noexcept {
+  // the scene: a viewport over (nearly) the whole EFB; partial ones (shadow maps, reflections and
+  // other pictures drawn into a corner and copied out) stay as recorded
+  const bool scene = g_efbPass && width >= 0.9f * g_passWidth && height >= 0.9f * g_passHeight;
+  g_word = scene ? make_word(g_eye) : 0;
+}
+
+void end_pass() noexcept {
+  g_efbPass = false;
+  g_word = 0;
+}
+
+uint32_t draw_word() noexcept { return g_word; }
+
+void request(bool stereo) noexcept { g_request.store(stereo, std::memory_order_relaxed); }
+bool take_request() noexcept { return g_request.load(std::memory_order_relaxed); }
+
+void set_eye(int eye) noexcept {
+  g_eye = eye;
+  g_replaying = eye > 0;
+}
+
+void copy_left_eye(wgpu::CommandEncoder& cmd) {
+  const auto& source = webgpu::present_source();
+  if (!g_left.texture || g_left.size.width != source.size.width || g_left.size.height != source.size.height ||
+      g_left.format != source.format) {
+    g_left = webgpu::create_render_texture(source.size.width, source.size.height, false);
+  }
+  const wgpu::TexelCopyTextureInfo src{.texture = source.texture};
+  const wgpu::TexelCopyTextureInfo dst{.texture = g_left.texture};
+  const wgpu::Extent3D size{source.size.width, source.size.height, 1};
+  cmd.CopyTextureToTexture(&src, &dst, &size);
+}
+
+void set_presented(bool stereo) noexcept { g_presented = stereo; }
+bool presented() noexcept { return g_presented; }
+const webgpu::TextureWithSampler& left_eye() noexcept { return g_left; }
+
+void shutdown() noexcept { g_left = {}; }
+
+} // namespace aurora::gfx::stereo
