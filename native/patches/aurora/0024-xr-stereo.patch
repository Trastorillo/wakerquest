new file mode 100644
index 0000000..1483a5e
--- /dev/null
+++ b/lib/gfx/stereo.hpp
@@ -0,0 +1,61 @@
+#pragma once
+
+// Stereoscopic 3D for the XR presentation (centollOS patch 0024, include/aurora/xr.h).
+//
+// A stereo frame is encoded twice. The left eye is the frame as it is recorded (each pass encoded as
+// it is sealed); at the end of the frame the EFB (the present source) is copied aside and every op
+// of the frame packet is encoded again for the right eye. EFB copies and whatever samples the screen
+// are thus redone with the right eye's picture. In both, the scene's perspective draws over the
+// whole EFB carry the eye's shift in their immediates (DrawImmediateData::_pad, read by the GX
+// vertex shader); everything else is drawn as recorded. All of this runs on the render worker.
+
+#include <cstdint>
+
+namespace wgpu {
+class CommandEncoder;
+}
+
+namespace aurora::webgpu {
+struct TextureWithSampler;
+}
+
+namespace aurora::gfx::detail {
+struct FramePacket;
+struct RenderPass;
+} // namespace aurora::gfx::detail
+
+namespace aurora::gfx::stereo {
+
+// Render worker, at the start of a frame's encoding: whether its left eye is shifted.
+void begin_frame() noexcept;
+// This frame's draws are encoded per eye (its left eye is shifted).
+bool frame_active() noexcept;
+// The right eye's replay is being encoded (passes skip their readbacks and GPU timing).
+bool replaying() noexcept;
+
+// render_pass: a pass begins, and its viewport is set; the draws that follow carry draw_word().
+void begin_pass(const detail::RenderPass& pass) noexcept;
+void set_viewport(float width, float height) noexcept;
+void end_pass() noexcept;
+// The value for DrawImmediateData::_pad: the eye's shift and the focus (two snorm16), 0 for none.
+uint32_t draw_word() noexcept;
+
+// Game thread (or the GX FIFO worker), before gfx::end_frame: whether this frame may be shown in
+// stereo (nothing is drawn over it that has to be in both eyes alike, such as ImGui).
+void request(bool stereo) noexcept;
+bool take_request() noexcept;
+
+// Render worker, in the end of a frame (encoding.cpp): copies the left eye's picture aside and
+// encodes the frame again for the right eye. Afterwards presented() is true until the next frame.
+void encode_right_eye(wgpu::CommandEncoder& cmd, detail::FramePacket& frame);
+void set_presented(bool stereo) noexcept;
+bool presented() noexcept;
+// The left eye's picture of the last stereo frame (the present source's size and format).
+const webgpu::TextureWithSampler& left_eye() noexcept;
+
+// The eye being encoded, for the replay (encoding.cpp).
+void set_eye(int eye) noexcept;
+void copy_left_eye(wgpu::CommandEncoder& cmd);
+void shutdown() noexcept;
+
+} // namespace aurora::gfx::stereo
