@@ -16,7 +16,7 @@ int g_eye = 0;               // 0 mono, -1 left, +1 right
 bool g_frameActive = false;  // this frame's left eye was shifted
 bool g_replaying = false;
 bool g_presented = false;
-float g_strength = 0.f, g_focus = 0.f;  // latched per frame
+float g_a = 0.f, g_b = 0.f;  // clip.x += eye * (a * w + b), latched per frame (patch 0025)
 bool g_efbPass = false;
 float g_passWidth = 0.f, g_passHeight = 0.f;
 uint32_t g_word = 0;
@@ -26,20 +26,22 @@ std::atomic_bool g_request{false};
 
 int16_t snorm16(float v) { return static_cast<int16_t>(std::lround(std::clamp(v, -1.f, 1.f) * 32767.f)); }
 
-// unpack2x16snorm in the shader: x from the low 16 bits; focus in units of 16384 game units
+// unpack2x16snorm in the shader: x = the eye's a (from the low 16 bits); y = sign(b) * sqrt(|b| / 64), so
+// that both a screen's focus term (several clip units) and the diorama's eye offset (a few hundredths)
+// keep their precision (patch 0025)
 uint32_t make_word(int eye) {
-  const float k = static_cast<float>(eye) * g_strength;
-  const uint32_t x = static_cast<uint16_t>(snorm16(k));
-  const uint32_t y = static_cast<uint16_t>(snorm16(g_focus / 16384.f));
-  const uint32_t word = x | (y << 16);
+  const float a = static_cast<float>(eye) * g_a;
+  const float b = static_cast<float>(eye) * g_b;
+  const float y = std::copysign(std::sqrt(std::min(std::fabs(b), 64.f) / 64.f), b);
+  const uint32_t word = static_cast<uint16_t>(snorm16(a)) | (static_cast<uint32_t>(static_cast<uint16_t>(snorm16(y))) << 16);
   return word != 0 ? word : 1u;  // a non-zero word for "shift by nothing"
 }
 } // namespace
 
