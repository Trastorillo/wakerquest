+// Patch 0035: the diorama's table into this eye, as the window's (patch 0033): each eye's scene kept by
+// a scissor to the bounds of what the mask can show, so the pixels it hides (the room around the table:
+// the rest of the room's or the island's geometry, drawn whole by the per-object culling when a large
+// model crosses the table) are not shaded. The volume, in the table's space: the box (x and z within
+// +-1, from the cut at y -1 up to kTopMetres above the top: the mask keeps everything above the table,
+// this caps it where nothing of the model reaches), or the bubble's cube (radius 1), and the free
+// spheres' cubes (the birds about the room). Clipped at the eye's near plane (w > 0), so a table that
+// reaches past the eyes, beside or behind the player, still gives the part of it in view; nothing in
+// front of the eye: no scissor.
+void table_scissor_begin(const webgpu::xr_present::DioramaMask& mk) noexcept {
+  const M4 clipFromTable = inverse(table_from_clip(mk, g_eye < 0 ? 0 : 1));
+  // the table's units per metre up (its y row's scale) for the cap above the top
+  constexpr float kTopMetres = 2.f;
+  const float* r1 = &mk.tableFromHead[4];
+  const float yPerMetre = std::sqrt(r1[0] * r1[0] + r1[1] * r1[1] + r1[2] * r1[2]);
+  const bool bubble = mk.fade[3] > 0.5f;
+  const float top = bubble ? 1.f : std::max(0.f, kTopMetres * yPerMetre);
+  float lo[2] = {1e30f, 1e30f}, hi[2] = {-1e30f, -1e30f};
+  bool any = false;
+  // one box (min, max in the table's space): its corners in front of the eye, and where its edges cross
+  // the near plane w = kNearW
+  constexpr float kNearW = 1e-3f;
+  const auto addBox = [&](const float mn[3], const float mx[3]) {
+    float c[8][4];
+    for (int i = 0; i < 8; i++) {
+      const float p[4] = {(i & 1) ? mx[0] : mn[0], (i & 2) ? mx[1] : mn[1], (i & 4) ? mx[2] : mn[2], 1.f};
+      for (int r = 0; r < 4; r++) {
+        c[i][r] = 0.f;
+        for (int k = 0; k < 4; k++) c[i][r] += clipFromTable.m[r][k] * p[k];
+      }
+    }
+    const auto add = [&](const float* q) {
+      for (int a = 0; a < 2; a++) {
+        lo[a] = std::min(lo[a], q[a] / q[3]);
+        hi[a] = std::max(hi[a], q[a] / q[3]);
+      }
+      any = true;
+    };
+    for (int i = 0; i < 8; i++) {
+      if (c[i][3] > kNearW) add(c[i]);
+    }
+    // the 12 edges: corners differing in one bit
+    for (int i = 0; i < 8; i++) {
+      for (int bit = 1; bit < 8; bit <<= 1) {
+        const int j = i | bit;
+        if (j == i) continue;
+        const float wi = c[i][3], wj = c[j][3];
+        if ((wi > kNearW) == (wj > kNearW)) continue;
+        const float t = (kNearW - wi) / (wj - wi);
+        float q[4];
+        for (int r = 0; r < 4; r++) q[r] = c[i][r] + (c[j][r] - c[i][r]) * t;
+        q[3] = kNearW;
+        add(q);
+      }
+    }
+  };
+  {
+    const float mn[3] = {-1.f, -1.f, -1.f};
+    const float mx[3] = {1.f, top, 1.f};
+    addBox(mn, mx);
+  }
+  const int spheres = std::clamp(mk.freeCount, 0, 16);
+  for (int i = 0; i < spheres; i++) {
+    const float* f = mk.free[i];
+    const float mn[3] = {f[0] - f[3], f[1] - f[3], f[2] - f[3]};
+    const float mx[3] = {f[0] + f[3], f[1] + f[3], f[2] + f[3]};
+    addBox(mn, mx);
+  }
+  if (!any) {
+    return;  // nothing in front of the eye: as before (no scissor)
+  }
+  // a margin for the head's move between the mask's pose and this frame's (5% of the picture a side)
+  constexpr float kMargin = 0.1f;
+  g_winNdc[0] = lo[0] - kMargin;
+  g_winNdc[1] = lo[1] - kMargin;
+  g_winNdc[2] = hi[0] + kMargin;
+  g_winNdc[3] = hi[1] + kMargin;
+  g_winValid = true;
+  // how much of the eye the scissor keeps, every 600 frames (the left eye's first scene pass)
+  static uint32_t s_count = 0;
+  if (g_eye < 0 && s_count++ % 600 == 0) {
+    const float w = std::clamp(g_winNdc[2], -1.f, 1.f) - std::clamp(g_winNdc[0], -1.f, 1.f);
+    const float h = std::clamp(g_winNdc[3], -1.f, 1.f) - std::clamp(g_winNdc[1], -1.f, 1.f);
+    Log.info("XR diorama: the table's scissor keeps {:.0f}% of the eye", std::max(0.f, w * h) * 25.f);
+  }
+}
 } // namespace
 
