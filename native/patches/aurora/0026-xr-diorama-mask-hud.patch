+  const auto pipelineLayout = webgpu::g_device.CreatePipelineLayout(&pipelineLayoutDesc);
+  const wgpu::ColorTargetState target{.format = wgpu::TextureFormat::RGBA8Unorm, .writeMask = wgpu::ColorWriteMask::All};
+  const wgpu::FragmentState fragment{.module = module, .entryPoint = "fs_main", .targetCount = 1, .targets = &target};
+  const wgpu::RenderPipelineDescriptor desc{
+      .label = "XR diorama mask",
+      .layout = pipelineLayout,
+      .vertex = {.module = module, .entryPoint = "vs_main"},
+      .primitive = {.topology = wgpu::PrimitiveTopology::TriangleList},
+      .multisample = {.count = 1, .mask = UINT32_MAX},
+      .fragment = &fragment,
+  };
+  g_maskPipeline = webgpu::g_device.CreateRenderPipeline(&desc);
+  for (auto& buffer : g_maskUniform) {
+    const wgpu::BufferDescriptor bufferDesc{
+        .label = "XR diorama mask uniform",
+        .usage = wgpu::BufferUsage::CopyDst | wgpu::BufferUsage::Uniform,
+        .size = sizeof(MaskUniform),
+    };
+    buffer = webgpu::g_device.CreateBuffer(&bufferDesc);
+  }
+}
+
+// Table from the eye's clip space: tableFromHead * (the eye's clip from head)^-1, the clip matrix as
+// Aurora's GX uniforms build it (fill_uniform: the projection's depth row reversed) plus the eye's shift.
+M4 table_from_clip(const webgpu::xr_present::DioramaMask& mk, int eye) {
+  const float* p = mk.proj;
+  const float shift = (eye == 0 ? -1.f : 1.f) * mk.eyeShift;
+  M4 clip{};
+  clip.m[0][0] = p[0];
+  clip.m[0][2] = p[1];
+  clip.m[0][3] = shift;
+  clip.m[1][1] = p[2];
+  clip.m[1][2] = p[3];
+  clip.m[2][2] = p[4];
+  clip.m[2][3] = p[5];
+  clip.m[3][2] = -1.f;
+  if constexpr (gx::UseReversedZ) {
+    for (int j = 0; j < 4; j++) clip.m[2][j] = -clip.m[2][j];
+  } else {
+    for (int j = 0; j < 4; j++) clip.m[2][j] += clip.m[3][j];
+  }
+  M4 table{};
+  for (int i = 0; i < 3; i++)
+    for (int j = 0; j < 4; j++) table.m[i][j] = mk.tableFromHead[i * 4 + j];
+  table.m[3][3] = 1.f;
+  return mul(table, inverse(clip));
+}
+} // namespace
+
+void clear_efb(wgpu::CommandEncoder& cmd) {
+  const wgpu::RenderPassColorAttachment color{
+      .view = webgpu::g_frameBuffer.view,
+      .loadOp = wgpu::LoadOp::Clear,
+      .storeOp = wgpu::StoreOp::Store,
+      .clearValue = {0.0, 0.0, 0.0, 0.0},
+  };
+  const wgpu::RenderPassDepthStencilAttachment depth{
+      .view = webgpu::g_depthBuffer.view,
+      .depthLoadOp = wgpu::LoadOp::Clear,
+      .depthStoreOp = wgpu::StoreOp::Store,
+      .depthClearValue = gx::UseReversedZ ? 0.f : 1.f,
+  };
+  const wgpu::RenderPassDescriptor desc{
+      .label = "XR HUD clear",
+      .colorAttachmentCount = 1,
+      .colorAttachments = &color,
+      .depthStencilAttachment = &depth,
+  };
+  auto pass = cmd.BeginRenderPass(&desc);
+  pass.End();
+}
+
+void encode_mask(wgpu::CommandEncoder& cmd, int eye) {
+  webgpu::xr_present::DioramaMask mk;
+  if (!webgpu::xr_present::diorama_mask(mk)) {
+    return;
+  }
+  if (!g_maskPipeline) {
+    create_mask_pipeline();
+  }
+  const auto& source = webgpu::present_source();
+  auto& target = g_masked[eye];
+  if (!target.texture || target.size.width != source.size.width || target.size.height != source.size.height) {
+    target = webgpu::create_render_texture(source.size.width, source.size.height, false);
+  }
+  const M4 m = table_from_clip(mk, eye);
+  MaskUniform u{};
+  for (int i = 0; i < 4; i++)
+    for (int j = 0; j < 4; j++) u.tableFromClip[j * 4 + i] = m.m[i][j];
+  u.fade[0] = std::max(mk.fade[0], 1e-3f);
+  u.fade[1] = std::max(mk.fade[1], 1e-3f);
+  u.fade[2] = std::max(mk.fade[2], 1e-3f);
+  webgpu::g_queue.WriteBuffer(g_maskUniform[eye], 0, &u, sizeof(u));
+  const std::array bindEntries{
+      wgpu::BindGroupEntry{.binding = 0, .buffer = g_maskUniform[eye], .size = sizeof(MaskUniform)},
+      wgpu::BindGroupEntry{.binding = 1, .textureView = source.view},
+      wgpu::BindGroupEntry{.binding = 2, .textureView = webgpu::g_depthBuffer.view},
+  };
+  const wgpu::BindGroupDescriptor bindDesc{.layout = g_maskLayout, .entryCount = bindEntries.size(), .entries = bindEntries.data()};
+  const auto bindGroup = webgpu::g_device.CreateBindGroup(&bindDesc);
+  const wgpu::RenderPassColorAttachment color{
+      .view = target.view,
+      .loadOp = wgpu::LoadOp::Clear,
+      .storeOp = wgpu::StoreOp::Store,
+      .clearValue = {0.0, 0.0, 0.0, 0.0},
+  };
+  const wgpu::RenderPassDescriptor desc{.label = "XR diorama mask", .colorAttachmentCount = 1, .colorAttachments = &color};
+  auto pass = cmd.BeginRenderPass(&desc);
+  pass.SetPipeline(g_maskPipeline);
+  pass.SetBindGroup(0, bindGroup, 0, nullptr);
+  pass.Draw(3);
+  pass.End();
+}
+
+const webgpu::TextureWithSampler& masked_eye(int eye) noexcept { return g_masked[eye]; }
+
+void shutdown() noexcept {
+  g_left = {};
+  g_masked[0] = g_masked[1] = {};
+  g_maskPipeline = {};
+  g_maskLayout = {};
+  g_maskUniform[0] = g_maskUniform[1] = {};
+}
 
 } // namespace aurora::gfx::stereo
