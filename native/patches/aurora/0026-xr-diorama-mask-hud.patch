+    var p = array<vec2f, 3>(vec2f(-1.0, 1.0), vec2f(-1.0, -3.0), vec2f(3.0, 1.0));
+    var t = array<vec2f, 3>(vec2f(0.0, 0.0), vec2f(0.0, 2.0), vec2f(2.0, 0.0));
+    var out: VertexOutput;
+    out.pos = vec4f(p[i], 0.0, 1.0);
+    out.uv = t[i];
