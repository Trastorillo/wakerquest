+void aurora_xr_set_diorama_free(const float* spheres, int count) {
+  std::lock_guard lock{g_maskMutex};
+  count = std::clamp(count, 0, AURORA_XR_FREE_SPHERES);
+  if (spheres != nullptr) std::copy(spheres, spheres + count * 4, &g_mask.free[0][0]);
+  g_mask.freeCount = spheres != nullptr ? count : 0;
+}
