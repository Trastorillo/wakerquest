+void AuroraSetSeeThrough(const f32* params) {
+  GX_WRITE_AURORA(GX_AURORA_SET_SEE_THROUGH);
+  if (params == nullptr) {
+    GX_WRITE_U8(0);
+    return;
+  }
+  GX_WRITE_U8(1);
+  for (int i = 0; i < 8; ++i) {
+    GX_WRITE_F32(params[i]);
+  }
+}
+
+void AuroraSetClipPlane(const f32* plane) {
+  GX_WRITE_AURORA(GX_AURORA_SET_CLIP_PLANE);
+  if (plane == nullptr) {
+    GX_WRITE_U8(0);
+    return;
+  }
+  GX_WRITE_U8(1);
+  for (int i = 0; i < 4; ++i) {
+    GX_WRITE_F32(plane[i]);
+  }
+}
+
 void GXCreateFrameBuffer(u32 width, u32 height) {
   GX_WRITE_AURORA(GX_AURORA_BEGIN_OFFSCREEN);
   GX_WRITE_U32(width);
