 #define GX_AURORA_SET_AMBIENT 0x0054
 
+/**
+ * The window's pop-out volume (native/patches/aurora/0037): followed by a u8. 0 turns it off. 1 is followed
+ * by 13 f32: the window's table from the view delta's target space (row-major 3x4: x and y within +-1 over
+ * the window's rectangle, z in metres toward the player), then the game camera's depth in front of it
+ * (metres). While on, the fragments of a draw the view delta applies to that are in front of the window's
+ * plane but outside the rectangle narrowing toward the camera's eye are discarded: what the window's mask
+ * would cut there is not drawn, so what is behind it shows. Off at the end of each frame.
+ */
+#define GX_AURORA_SET_POPOUT_CLIP 0x0055
+
 #define GX2_SET_POLYGON_OFFSET 0x1000
 
 
@@ -239,6 +249,12 @@ void AuroraSetSeeThrough(const f32* params);
  */
 void AuroraSetClipPlane(const f32* plane);
 
+/**
+ * GX_AURORA_SET_POPOUT_CLIP, recorded in the command stream: the table (12 f32) and the camera's depth, or
+ * NULL to turn it off.
+ */
+void AuroraSetPopoutClip(const f32* tableFromView, f32 depth);
+
 /**
  * GX_AURORA_SET_AMBIENT, recorded in the command stream.
