--- a/lib/dolphin/gx/GXAurora.cpp
+++ b/lib/dolphin/gx/GXAurora.cpp
@@ -136,6 +136,19 @@ void AuroraSetClipPlane(const f32* plane) {
   }
 }
 
+void AuroraSetPopoutClip(const f32* tableFromView, f32 depth) {
+  GX_WRITE_AURORA(GX_AURORA_SET_POPOUT_CLIP);
+  if (tableFromView == nullptr) {
+    GX_WRITE_U8(0);
+    return;
+  }
+  GX_WRITE_U8(1);
+  for (int i = 0; i < 12; ++i) {
+    GX_WRITE_F32(tableFromView[i]);
+  }
+  GX_WRITE_F32(depth);
+}
