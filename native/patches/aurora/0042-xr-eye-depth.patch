+  };
+  const wgpu::RenderPassDescriptor desc{.label = "XR eye depth copy", .colorAttachmentCount = 1, .colorAttachments = &color};
+  auto pass = cmd.BeginRenderPass(&desc);
+  pass.SetPipeline(g_depthCopyPipeline);
+  pass.SetBindGroup(0, bindGroup, 0, nullptr);
