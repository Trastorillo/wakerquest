+namespace {
+// Patch 0042: the eyes' depth for the XR layer's reprojection (include/aurora/xr.h, AuroraXrFrame.depth).
+// Each texel of an eye's half-size picture: the nearest of the 2x2 EFB depths under it that something was
+// drawn at, taken back to the head's space by the eye's clip matrix (clip_from_head: the frame's own
+// frustum, eye shift and depth convention, as the mask), as the inverse of its distance along the view
+// axis (-z; the eye is the head moved along its x, so the head's z is the eye's), in metres of the room,
+// times AURORA_XR_DEPTH_REF, in 16 bits over R (high) and G (low). 0: nothing drawn (the depth as
+// cleared): the XR layer takes it as infinitely far. The XR layer undoes it (android/xr/wq_reproj.cpp).
+struct DepthUniform {
+  float headFromClip[16];  // column-major for WGSL
+  float size[4];           // the EFB's picture (present source) w, h; the eye's depth w, h
+  float misc[4];           // the eye's x offset in the pair (px), AURORA_XR_DEPTH_REF, the cleared depth,
+                           // 1 with reversed Z (nearer: larger), -1 without
+};
+
+constexpr const char* kEyeDepthShader = R"(
+struct U {
+    head_from_clip: mat4x4f,
+    size: vec4f,
+    misc: vec4f,
+};
+@group(0) @binding(0) var<uniform> u: U;
+@group(0) @binding(1) var depth_tex: texture_depth_2d;
+
+@vertex
+fn vs_main(@builtin(vertex_index) i: u32) -> @builtin(position) vec4f {
+    var p = array<vec2f, 3>(vec2f(-1.0, 1.0), vec2f(-1.0, -3.0), vec2f(3.0, 1.0));
+    return vec4f(p[i], 0.0, 1.0);
+}
+
+@fragment
+fn fs_main(@builtin(position) pos: vec4f) -> @location(0) vec4f {
+    let p = pos.xy - vec2f(u.misc.x, 0.0);
+    let k = u.size.xy / u.size.zw;
+    let hi = vec2i(u.size.xy) - vec2i(1, 1);
+    let a = clamp(vec2i(floor((p - 0.25) * k)), vec2i(0, 0), hi);
+    let b = clamp(vec2i(floor((p + 0.25) * k)), vec2i(0, 0), hi);
+    // the nearest of the four (s: nearer is larger with reversed Z); none drawn: the cleared value
+    let s = u.misc.w;
+    let key = max(max(s * textureLoad(depth_tex, a, 0), s * textureLoad(depth_tex, vec2i(b.x, a.y), 0)),
+                  max(s * textureLoad(depth_tex, vec2i(a.x, b.y), 0), s * textureLoad(depth_tex, b, 0)));
+    if (key <= s * u.misc.z) {
+        return vec4f(0.0);
+    }
+    let uv = p / u.size.zw;
+    let h = u.head_from_clip * vec4f(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, key * s, 1.0);
+    let dist = -h.z / h.w;
+    if (!(dist > 0.0)) {
+        return vec4f(0.0);
+    }
+    let q = u32(round(clamp(u.misc.y / dist, 0.0, 1.0) * 65535.0));
+    if (q == 0u) {
+        return vec4f(0.0);
+    }
+    return vec4f(f32(q >> 8u) / 255.0, f32(q & 255u) / 255.0, 0.0, 1.0);
+}
+)";
+
+constexpr const char* kEyeDepthCopyShader = R"(
+@group(0) @binding(0) var src: texture_2d<f32>;
+
+@vertex
+fn vs_main(@builtin(vertex_index) i: u32) -> @builtin(position) vec4f {
+    var p = array<vec2f, 3>(vec2f(-1.0, 1.0), vec2f(-1.0, -3.0), vec2f(3.0, 1.0));
+    return vec4f(p[i], 0.0, 1.0);
+}
+
+@fragment
+fn fs_main(@builtin(position) pos: vec4f) -> @location(0) vec4f {
+    return textureLoad(src, vec2i(pos.xy), 0);
+}
+)";
+
+wgpu::RenderPipeline make_plain_pipeline(const char* label, const char* code, const wgpu::BindGroupLayout& layout) {
+  wgpu::ShaderSourceWGSL source{};
+  source.code = code;
+  const wgpu::ShaderModuleDescriptor moduleDesc{.nextInChain = &source, .label = label};
+  const auto module = webgpu::g_device.CreateShaderModule(&moduleDesc);
+  const wgpu::PipelineLayoutDescriptor pipelineLayoutDesc{.bindGroupLayoutCount = 1, .bindGroupLayouts = &layout};
+  const auto pipelineLayout = webgpu::g_device.CreatePipelineLayout(&pipelineLayoutDesc);
+  const wgpu::ColorTargetState target{.format = wgpu::TextureFormat::RGBA8Unorm, .writeMask = wgpu::ColorWriteMask::All};
+  const wgpu::FragmentState fragment{.module = module, .entryPoint = "fs_main", .targetCount = 1, .targets = &target};
+  const wgpu::RenderPipelineDescriptor desc{
+      .label = label,
+      .layout = pipelineLayout,
+      .vertex = {.module = module, .entryPoint = "vs_main"},
+      .primitive = {.topology = wgpu::PrimitiveTopology::TriangleList},
+      .multisample = {.count = 1, .mask = UINT32_MAX},
+      .fragment = &fragment,
+  };
+  return webgpu::g_device.CreateRenderPipeline(&desc);
+}
+
+void create_depth_pipelines() {
+  {
+    const std::array entries{
+        wgpu::BindGroupLayoutEntry{
+            .binding = 0,
+            .visibility = wgpu::ShaderStage::Fragment,
+            .buffer = {.type = wgpu::BufferBindingType::Uniform, .minBindingSize = sizeof(DepthUniform)},
+        },
+        wgpu::BindGroupLayoutEntry{
+            .binding = 1,
+            .visibility = wgpu::ShaderStage::Fragment,
+            .texture = {.sampleType = wgpu::TextureSampleType::Depth, .viewDimension = wgpu::TextureViewDimension::e2D},
+        },
+    };
+    const wgpu::BindGroupLayoutDescriptor layoutDesc{.entryCount = entries.size(), .entries = entries.data()};
+    g_depthLayout = webgpu::g_device.CreateBindGroupLayout(&layoutDesc);
+    g_depthPipeline = make_plain_pipeline("XR eye depth", kEyeDepthShader, g_depthLayout);
+  }
+  {
+    const wgpu::BindGroupLayoutEntry entry{
+        .binding = 0,
+        .visibility = wgpu::ShaderStage::Fragment,
+        .texture = {.sampleType = wgpu::TextureSampleType::UnfilterableFloat,
+                    .viewDimension = wgpu::TextureViewDimension::e2D},
+    };
+    const wgpu::BindGroupLayoutDescriptor layoutDesc{.entryCount = 1, .entries = &entry};
+    g_depthCopyLayout = webgpu::g_device.CreateBindGroupLayout(&layoutDesc);
+    g_depthCopyPipeline = make_plain_pipeline("XR eye depth copy", kEyeDepthCopyShader, g_depthCopyLayout);
+  }
+  for (auto& buffer : g_depthUniform) {
+    const wgpu::BufferDescriptor bufferDesc{
+        .label = "XR eye depth uniform",
+        .usage = wgpu::BufferUsage::CopyDst | wgpu::BufferUsage::Uniform,
+        .size = sizeof(DepthUniform),
+    };
+    buffer = webgpu::g_device.CreateBuffer(&bufferDesc);
+  }
+}
+
+// Right after the eye's mask, its depth still in the EFB: its half of g_depthPair (the left eye clears it)
+void encode_eye_depth(wgpu::CommandEncoder& cmd, int eye, const webgpu::xr_present::DioramaMask& mk) {
+  if (!g_depthPipeline) {
+    create_depth_pipelines();
+  }
+  uint32_t w = 0, h = 0;
+  eye_depth_size(w, h);
+  if (!g_depthPair.texture || g_depthPair.size.width != 2 * w || g_depthPair.size.height != h) {
+    g_depthPair = webgpu::create_render_texture(2 * w, h, false);
+    g_depthReady[0] = g_depthReady[1] = false;
+  }
+  const auto& source = webgpu::present_source();
+  const M4 m = inverse(clip_from_head(mk, eye));
+  DepthUniform u{};
+  for (int i = 0; i < 4; i++)
+    for (int j = 0; j < 4; j++) u.headFromClip[j * 4 + i] = m.m[i][j];
+  u.size[0] = static_cast<float>(source.size.width);
+  u.size[1] = static_cast<float>(source.size.height);
+  u.size[2] = static_cast<float>(w);
+  u.size[3] = static_cast<float>(h);
+  u.misc[0] = static_cast<float>(eye * w);
+  u.misc[1] = AURORA_XR_DEPTH_REF;
+  u.misc[2] = gx::UseReversedZ ? 0.f : 1.f;  // the depth as cleared: nothing drawn
+  u.misc[3] = gx::UseReversedZ ? 1.f : -1.f;
+  webgpu::g_queue.WriteBuffer(g_depthUniform[eye], 0, &u, sizeof(u));
+  const std::array bindEntries{
+      wgpu::BindGroupEntry{.binding = 0, .buffer = g_depthUniform[eye], .size = sizeof(DepthUniform)},
+      wgpu::BindGroupEntry{.binding = 1, .textureView = webgpu::g_depthBuffer.view},
+  };
+  const wgpu::BindGroupDescriptor bindDesc{.layout = g_depthLayout, .entryCount = bindEntries.size(), .entries = bindEntries.data()};
+  const auto bindGroup = webgpu::g_device.CreateBindGroup(&bindDesc);
+  const wgpu::RenderPassColorAttachment color{
+      .view = g_depthPair.view,
+      .loadOp = eye == 0 ? wgpu::LoadOp::Clear : wgpu::LoadOp::Load,
+      .storeOp = wgpu::StoreOp::Store,
+      .clearValue = {0.0, 0.0, 0.0, 0.0},
+  };
+  const wgpu::RenderPassDescriptor desc{.label = "XR eye depth", .colorAttachmentCount = 1, .colorAttachments = &color};
+  auto pass = cmd.BeginRenderPass(&desc);
+  pass.SetPipeline(g_depthPipeline);
+  pass.SetBindGroup(0, bindGroup, 0, nullptr);
+  pass.SetViewport(static_cast<float>(eye * w), 0.f, static_cast<float>(w), static_cast<float>(h), 0.f, 1.f);
+  pass.Draw(3);
+  pass.End();
+  // the right eye counts only after the left (its Load keeps the left's half of this frame)
+  g_depthReady[eye] = eye == 0 || g_depthReady[0];
+}
