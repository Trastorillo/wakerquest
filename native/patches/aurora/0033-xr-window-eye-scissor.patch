+
+// Patch 0033: the window's rectangle in the table's space (x, y within +-1 at z 0) and what may come
+// out of it (the rectangle narrowing toward the camera's eye, up to the pop-out), into this eye's clip
+// space; its NDC bounds, or nothing when a corner is at or behind the eye.
+void window_scissor_begin() noexcept {
+  webgpu::xr_present::DioramaMask mk;
+  if (g_eye == 0 || !webgpu::xr_present::diorama_mask(mk) || mk.fade[3] <= 1.5f) {
+    return;
+  }
+  const M4 clipFromTable = inverse(table_from_clip(mk, g_eye < 0 ? 0 : 1));
+  const float depth = std::max(mk.window[1], 1e-3f);
+  const float popout = std::clamp(std::min(mk.window[0], mk.window[1]), 0.f, depth);
+  const float narrow = (depth - popout) / depth;
+  float lo[2] = {1e30f, 1e30f}, hi[2] = {-1e30f, -1e30f};
+  for (int i = 0; i < 8; i++) {
+    const float s = i < 4 ? 1.f : narrow;
+    const float p[4] = {(i & 1) ? s : -s, (i & 2) ? s : -s, i < 4 ? 0.f : popout, 1.f};
+    float c[4];
+    for (int r = 0; r < 4; r++) {
+      c[r] = 0.f;
+      for (int k = 0; k < 4; k++) c[r] += clipFromTable.m[r][k] * p[k];
+    }
+    if (c[3] <= 1e-4f) {
+      return;
+    }
+    for (int a = 0; a < 2; a++) {
+      lo[a] = std::min(lo[a], c[a] / c[3]);
+      hi[a] = std::max(hi[a], c[a] / c[3]);
+    }
+  }
+  // a margin for the head's move between the mask's pose and this frame's (5% of the picture a side)
+  constexpr float kMargin = 0.1f;
+  g_winNdc[0] = lo[0] - kMargin;
+  g_winNdc[1] = lo[1] - kMargin;
+  g_winNdc[2] = hi[0] + kMargin;
+  g_winNdc[3] = hi[1] + kMargin;
+  g_winValid = true;
+}
 } // namespace
 
+bool window_scissor(float left, float top, float width, float height, uint32_t& x0, uint32_t& y0, uint32_t& x1,
+                    uint32_t& y1) noexcept {
+  if (!g_winValid || g_word == 0 || width <= 0.f || height <= 0.f) {
+    return false;
+  }
+  const float nx0 = std::clamp(g_winNdc[0], -1.f, 1.f), nx1 = std::clamp(g_winNdc[2], -1.f, 1.f);
+  const float ny0 = std::clamp(g_winNdc[1], -1.f, 1.f), ny1 = std::clamp(g_winNdc[3], -1.f, 1.f);
+  // NDC y up; the target's pixels y down
+  const float px0 = left + (nx0 * 0.5f + 0.5f) * width, px1 = left + (nx1 * 0.5f + 0.5f) * width;
+  const float py0 = top + (0.5f - ny1 * 0.5f) * height, py1 = top + (0.5f - ny0 * 0.5f) * height;
+  x0 = static_cast<uint32_t>(std::max(0.f, std::floor(px0)));
+  y0 = static_cast<uint32_t>(std::max(0.f, std::floor(py0)));
+  x1 = static_cast<uint32_t>(std::max(0.f, std::ceil(px1)));
+  y1 = static_cast<uint32_t>(std::max(0.f, std::ceil(py1)));
+  return true;
+}
