+// true when the window's scissor narrowed it (patch 0033)
+bool apply_scissor(const wgpu::RenderPassEncoder& pass, const ClipRect& sc, const wgpu::Extent3D& size,
+                   const Viewport* vp = nullptr) {
+  auto x = std::clamp(static_cast<uint32_t>(sc.x), 0u, size.width);
+  auto y = std::clamp(static_cast<uint32_t>(sc.y), 0u, size.height);
+  auto w = std::clamp(static_cast<uint32_t>(sc.width), 0u, size.width - x);
+  auto h = std::clamp(static_cast<uint32_t>(sc.height), 0u, size.height - y);
+  // patch 0033: the window's frames, each eye's scene kept to the window as that eye sees it
+  uint32_t wx0, wy0, wx1, wy1;
+  const bool narrowed =
+      vp != nullptr && stereo::window_scissor(vp->left, vp->top, vp->width, vp->height, wx0, wy0, wx1, wy1);
+  if (narrowed) {
+    const uint32_t x0 = std::max(x, wx0), y0 = std::max(y, wy0);
+    const uint32_t x1 = std::min(x + w, wx1), y1 = std::min(y + h, wy1);
+    x = std::min(x0, size.width);
+    y = std::min(y0, size.height);
+    w = x1 > x ? x1 - x : 0u;
+    h = y1 > y ? y1 - y : 0u;
+  }
   pass.SetScissorRect(x, y, w, h);
+  return narrowed;
 }
 
