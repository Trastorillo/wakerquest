+// Snapdragon 8s Gen 3 still showed it there, so every zero input here, alpha's too: a uniform read each)
+std::string tev_zero3() { return webgpu::g_adrenoTevZeroWorkaround ? "ubuf.tev_zero.rgb" : "vec3f(0.0)"; }
+std::string tev_zero1() { return webgpu::g_adrenoTevZeroWorkaround ? "ubuf.tev_zero.a" : "0.0"; }
